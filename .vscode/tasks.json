{
  "version": "2.0.0",
  "type": "shell",

  "windows": {
    "options": { "shell": { "executable": "${env:ProgramFiles}/Git/bin/bash.exe", "args": ["-c"] } }
  },

  "tasks": [
    // Public
    {
      "label": "Check NPM Version",
      "detail": "Checks NPM version.",

      "type": "shell",
      "command": "bash",
      "args": ["scripts/check-package-version", "npm"],

      "runOptions": { "runOn": "folderOpen" },

      "options": { "statusbar": { "hide": true } }
    },

    // 1-1
    {
      "label": "Check sort-package-json version",
      "detail": "Checks sort-package-json version.",

      "type": "shell",
      "command": "bash",
      "args": ["scripts/check-package-version", "sort-package-json"],

      "options": { "statusbar": { "hide": true } }
    },

    // 1-2
    {
      "label": "sort-package-json",
      "detail": "Runs sort-package-json.",

      "dependsOn": ["Check sort-package-json version"],
      "dependsOrder": "sequence",

      "type": "shell",
      "command": "sort-package-json"
    },

    // 2-1
    {
      "label": "Check npm-check-updates version",
      "detail": "Checks npm-check-updates version.",

      "type": "shell",
      "command": "bash",
      "args": ["scripts/check-package-version", "npm-check-updates"],

      "options": { "statusbar": { "hide": true } }
    },

    // 2-2
    {
      "label": "npm-check-updates",
      "detail": "Runs npm-check-updates.",

      "dependsOn": ["Check npm-check-updates version"],
      "dependsOrder": "sequence",

      "type": "shell",
      "command": "npm-check-updates"
    },

    // 3-1
    {
      "label": "Check @devcontainers/cli version",
      "detail": "Checks @devcontainers/cli version.",

      "type": "shell",
      "command": "bash",
      "args": ["scripts/check-package-version", "@devcontainers/cli", "devcontainer"],

      "options": { "statusbar": { "hide": true } }
    },

    // 3-2
    {
      "label": "devcontainer upgrade",
      "detail": "Runs devcontainer upgrade.",

      "dependsOn": ["Check @devcontainers/cli version"],
      "dependsOrder": "sequence",

      "type": "shell",
      "command": "devcontainer upgrade"
    },

    // 4-1
    {
      "label": "Check gh actions-lock version",
      "detail": "Checks gh actions-lock version.",

      "type": "shell",
      "command": "gh",
      "args": ["extension", "upgrade", "github/gh-actions-lock"],

      "options": { "statusbar": { "hide": true } }
    },

    // 4-2
    {
      "label": "gh actions-lock",
      "detail": "Runs gh actions-lock.",

      "dependsOn": ["Check gh actions-lock version"],
      "dependsOrder": "sequence",

      "type": "shell",
      "command": "gh",
      "args": ["actions-lock", "--relock"]
    },

    // 5-1-1
    {
      "label": "codeql database create actions",
      "detail": "Creates the actions CodeQL database.",

      "type": "shell",
      "command": "codeql",
      "args": [
        "database",
        "create",
        ".github/codeql/database/actions",
        "--language=actions",
        "--overwrite"
      ],

      "options": { "statusbar": { "hide": true } }
    },

    // 5-2-1
    {
      "label": "codeql database create typescript",
      "detail": "Creates the TypeScript CodeQL database.",

      "type": "shell",
      "command": "codeql",
      "args": [
        "database",
        "create",
        ".github/codeql/database/typescript",
        "--language=typescript",
        "--overwrite"
      ],

      "options": { "statusbar": { "hide": true } }
    },

    // 5-1-2
    {
      "label": "codeql actions",
      "detail": "Creates and analyzes the actions CodeQL database.",

      "dependsOn": ["codeql database create actions"],
      "dependsOrder": "sequence",

      "type": "shell",
      "command": "codeql",
      "args": [
        "database",
        "analyze",
        ".github/codeql/database/actions",
        "actions-security-and-quality.qls",
        "--format=sarif-latest",
        "--output=.github/codeql/output/codeql-actions-output.sarif"
      ]
    },

    // 5-2-2
    {
      "label": "codeql typescript",
      "detail": "Creates and analyzes the TypeScript CodeQL database.",

      "dependsOn": ["codeql database create typescript"],
      "dependsOrder": "sequence",

      "type": "shell",
      "command": "codeql",
      "args": [
        "database",
        "analyze",
        ".github/codeql/database/typescript",
        ".github/codeql/queries/typescript-security-and-quality.qls",
        "--format=sarif-latest",
        "--output=.github/codeql/output/codeql-typescript-output.sarif"
      ]
    }
  ]
}
